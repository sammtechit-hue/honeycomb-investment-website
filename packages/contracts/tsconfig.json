{
  "compilerOptions": {
    // The sources use Node-style `./x.js` specifiers, so the emitted JS must be
    // ESM as well — the package is `"type": "module"`.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": ["ES2023"],

    // Emit runnable JS plus declarations into dist/ (gitignored).
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // The contracts are pure zod — no Node APIs, so no ambient types needed.
    "types": [],

    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
