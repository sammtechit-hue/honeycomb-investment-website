// ============================================================================
// Investment Platform — Prisma Schema (v8 — ambiguity fix pass)
// ============================================================================

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum InvestorCategory {
    bronze
    silver
    gold
    diamond
    platinum
    titanium
}

enum InvestorStatus {
    pending
    uploaded_kyc
    active
    suspended
}

enum KycDocType {
    nid
    photo
    other
}

enum VerificationStatus {
    pending
    verified
    rejected
}

enum BankAccountType {
    savings
    current
}

enum BankSelected {
    city_bank
    others
}

enum ProjectStatus {
    DRAFT
    OPEN
    FULL
    PAUSED
    COMPLETED
    CANCELLED
}

enum CompanyDocType {
    trade_license
    nid
    bank_account
    deed
}

enum InvestmentType {
    fixed
    unfixed
}

enum DisbursementPeriod {
    monthly
    quarterly
    half_yearly
    yearly
}

enum InvestmentStatus {
    pending
    active
}

enum PayoutStatus {
    accrued
    disbursed
}

enum DisbursementExportType {
    cbl
    beftn
    other
}

enum DisbursementBatchStatus {
    draft
    exported
    confirmed
}

enum ExportFormat {
    cbl
    beftn
}

enum WithdrawalStatus {
    pending
    notice_period
    ready
    paid
    cancelled
}

enum WithdrawalMethod {
    manual
    auto
}

enum IncomingPaymentMethod {
    bkash
    nagad
    rocket
    bank_transfer
}

enum IncomingPaymentStatus {
    pending
    confirmed
    overdue
}

enum BonusStatus {
    pending
    paid
}

enum Role {
    SUPER_ADMIN
    ADMIN
    MODERATOR
    INVESTOR
}

enum AdminNotificationType {
    upcoming_payout
    slot_reminder
    new_investment_request
    disbursement_sent
    company_document_expiring
}

enum PayoutSchedule {
    MONTHLY
    QUARTERLY
    YEARLY
}

enum DisbursementSlot {
    slot_1
    slot_2
    slot_3
    slot_4
}

// ----------------------------------------------------------------------------
// User (auth) — unified login for investors and admins (v6 merge)
// ----------------------------------------------------------------------------

model User {
    id           String   @id @default(uuid()) @db.Uuid
    email        String   @unique @db.VarChar(150)
    phone        String?  @unique @db.VarChar(20) // investor login identifier; null for admins
    passwordHash String   @map("password_hash") @db.VarChar(255)
    role         Role     @default(INVESTOR)
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    investorProfile Investor?
    adminProfile    AdminProfile?

    @@index([role])
    @@map("users")
}

// ----------------------------------------------------------------------------
// 1. Investor profile (1:1 with User where role = INVESTOR)
// ----------------------------------------------------------------------------

model Investor {
    id                    String           @id @default(uuid()) @db.Uuid
    fullname              String           @map("name") @db.VarChar(150)
    totalInvestmentAmount Decimal          @default(0) @map("total_investment_amount") @db.Decimal(18, 2)
    address               String?
    profession            String?          @db.VarChar(150)
    workplace             String?          @db.VarChar(150)
    // Non-nullable: every investor always has a category/status — the default
    // covers "not yet set", so null was never a meaningful third state.
    category              InvestorCategory @default(bronze)
    status                InvestorStatus   @default(pending)
    approvedAt            DateTime?        @map("approved_at")
    approvedBy            String?          @db.Uuid
    createdAt             DateTime         @default(now()) @map("created_at")
    updatedAt             DateTime         @updatedAt @map("updated_at")

    userId String @unique @map("user_id") @db.Uuid
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Was: Admin? — that model didn't exist. All "which admin did this"
    // references now consistently point at AdminProfile (see notes below).
    // approvedBy AdminProfile? @relation(fields: [approvedById], references: [id])

    kycDocuments InvestorKycDocument?
    bankAccount  InvestorBankAccount?
    nominee      Nominee?
    investments  Investment[]

    disbursementItems DisbursementItem[]

    // =========================================================================
    // REFERRAL RELATIONS
    // =========================================================================

    // The referral code that this investor used when joining the system.
    // An investor can use only one referral code.
    // null means the investor was not referred by another investor.
    referralCode ReferralCode? @relation("ReferralCodeUsedBy")

    // All referral codes generated/owned by this investor.
    // One investor can generate multiple referral codes.
    // Example:
    // Investor A → CODE001
    // Investor A → CODE002
    // Investor A → CODE003
    referralCodesGenerated ReferralCode[] @relation("InvestorReferralCodes")

    // The Referral record where this investor is the referred investor.
    // Optional because an investor may join without being referred.
    //
    // Because Referral.referredInvestorId is @unique,
    // an investor can only be referred ONCE in the entire system.
    //
    // Example:
    // Investor A → Investor B
    // Investor C → Investor B ❌
    //
    // Investor B can have only one referralsReceived record.
    referralsReceived Referral? @relation("ReferredInvestor")

    // All Referral records where this investor is the referrer.
    // One investor can refer many other investors.
    //
    // Example:
    // Investor A → Investor B
    // Investor A → Investor C
    // Investor A → Investor D
    //
    // Therefore this is an array: Referral[]
    referralsMade Referral[] @relation("ReferrerInvestor")

    @@index([status])
    @@map("investors")
}

// ----------------------------------------------------------------------------
// 1b. Admin profile (1:1 with User where role in ADMIN/MODERATOR/SUPER_ADMIN)
// ----------------------------------------------------------------------------

model AdminProfile {
    id             String  @id @default(uuid()) @db.Uuid
    name           String? @db.VarChar(150)
    allowedIpRange String? @map("allowed_ip_range") @db.VarChar(100)
    department     String? @db.VarChar(100)

    userId String @unique @map("user_id") @db.Uuid
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("admin_profiles")
}

// ----------------------------------------------------------------------------
// 2. Investor KYC Documents
// ----------------------------------------------------------------------------

model InvestorKycDocument {
    id                 String             @id @default(uuid()) @db.Uuid
    nidFront           String
    nidBack            String
    photo              String
    verificationStatus VerificationStatus @default(pending) @map("verification_status")
    uploadedAt         DateTime           @default(now()) @map("uploaded_at")

    investorId String   @unique @db.Uuid
    investor   Investor @relation(fields: [investorId], references: [id])

    @@index([verificationStatus])
    @@map("investor_kyc_documents")
}

// ----------------------------------------------------------------------------
// 3. Investor Bank Accounts
// ----------------------------------------------------------------------------

model InvestorBankAccount {
    id            String           @id @default(uuid()) @db.Uuid
    selectedBank  BankSelected     @map("selected_bank")
    bankName      String           @map("bank_name") @db.VarChar(100)
    accountName   String           @map("account_name") @db.VarChar(150)
    accountNumber String           @map("account_number") @db.VarChar(50)
    routingNumber String?          @map("routing_number") @db.VarChar(20)
    accountType   BankAccountType? @map("account_type")
    branchName    String?

    investorId String   @unique @map("investor_id") @db.Uuid
    investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

    @@map("investor_bank_accounts")
}

// ----------------------------------------------------------------------------
// 4. Nominees
// ----------------------------------------------------------------------------

model Nominee {
    id              String  @id @default(uuid()) @db.Uuid
    nomineeName     String  @map("nominee_name") @db.VarChar(150)
    nomineeNidFront String? @db.VarChar(30)
    nomineeNidBack  String? @db.VarChar(30)
    nomineePhoto    String? @map("nominee_photo")
    nomineePhone    String  @map("nominee_phone") @db.VarChar(20)
    relation        String  @db.VarChar(50)

    investorId String   @unique @map("investor_id") @db.Uuid
    investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

    @@map("nominees")
}

// ----------------------------------------------------------------------------
// 5. Projects
// ----------------------------------------------------------------------------

model Project {
    id          String  @id @default(uuid()) @db.Uuid
    name        String  @db.VarChar(150)
    description String?

    status ProjectStatus @default(DRAFT)

    minimumInvestment Decimal  @db.Decimal(18, 2)
    maximumInvestment Decimal? @db.Decimal(18, 2)

    targetAmount        Decimal? @db.Decimal(18, 2)
    totalInvestedAmount Decimal  @default(0) @db.Decimal(18, 2)

    startDate DateTime
    endDate   DateTime?

    isActive  Boolean @default(true)
    isVisible Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    investments Investment[]

    @@index([status])
    @@index([isVisible, isActive])
    @@map("projects")
}

// ----------------------------------------------------------------------------
// 6. Company Documents
// ----------------------------------------------------------------------------

model CompanyDocument {
    id         String         @id @default(uuid()) @db.Uuid
    docType    CompanyDocType @map("doc_type")
    fileUrl    String         @map("file_url")
    isCurrent  Boolean        @default(true) @map("is_current")
    uploadedAt DateTime       @default(now()) @map("uploaded_at")
    expiresAt  DateTime?      @map("expires_at") @db.Date

    @@index([docType, isCurrent])
    @@map("company_documents")
}

// ----------------------------------------------------------------------------
// 7. Investments
// ----------------------------------------------------------------------------

model Investment {
    id                     String         @id @default(uuid()) @db.Uuid
    investmentDate         DateTime?      @map("investment_date")
    amount                 Decimal        @db.Decimal(14, 2)
    investmentType         InvestmentType @map("investment_type")
    rate                   Decimal?       @db.Decimal(5, 2)
    investmentPeriodMonths Int?           @default(3) @map("investment_period_months")

    disbursementPeriod      DisbursementPeriod @map("disbursement_period")
    agreementPlace          String?            @map("agreement_place") @db.VarChar(150)
    agreementEndDate        DateTime?          @map("agreement_end_date") @db.Date
    deedOffical             String?
    deedGoverment           String?
    chequeGiven             Boolean            @default(false) @map("cheque_given")
    cashVoucharGiven        Boolean            @default(false) @map("cash_vouchar_given")
    specialInstruction      String?            @map("special_instruction")
    souvenirGiven           Boolean            @default(false) @map("souvenir_given")
    isSouvenirApplicable    Boolean            @default(true) @map("is_souvenir_applicable")
    certificateGiven        Boolean            @default(false) @map("certificate_given")
    isCertificateApplicable Boolean            @default(true) @map("is_certificate_applicable")
    status                  InvestmentStatus   @default(pending)

    // disbursementSlot    DisbursementSlot? @map("disbursement_slot")
    // slotManuallyChanged Boolean           @default(false) @map("slot_manually_changed")
    // slotAdjustmentDays  Int?              @map("slot_adjustment_days")

    createdAt DateTime @default(now()) @map("created_at")

    investorId String   @map("investor_id") @db.Uuid
    investor   Investor @relation(fields: [investorId], references: [id])

    projectId String  @map("project_id") @db.Uuid
    project   Project @relation(fields: [projectId], references: [id])

    monthlyProfitLedger MonthlyProfitLedger[]
    incomingPayments    IncomingPayment[]
    withdrawalRequests  WithdrawalRequest[]
    investmentDocuments InvestmentDocument?
    disbursementItems   DisbursementItem[]

    @@index([investorId])
    @@index([projectId])
    @@index([status])
    @@map("investments")
}

model InvestmentDocument {
    id String @id @default(uuid()) @db.Uuid

    online_deed     String?
    certificate     String?
    cheque          String?
    cash_voucher    String?
    membership_card String?
    souvenir        String?
    proof_photo     String?
    clearance_video String?

    uploadedAt DateTime @default(now()) @map("uploaded_at")

    investmentId String     @unique @map("investment_id") @db.Uuid
    investment   Investment @relation(fields: [investmentId], references: [id])
    // adminProfileId String?       @db.Uuid
    // adminProfile   AdminProfile? @relation(fields: [adminProfileId], references: [id])

    @@index([investmentId])
    @@map("investment_documents")
}

// ----------------------------------------------------------------------------
// 8. Monthly Rate Settings
// ----------------------------------------------------------------------------
//Not clear
model MonthlyRateSetting {
    id          String   @id @default(uuid()) @db.Uuid
    periodMonth DateTime @unique @map("period_month") @db.Date
    ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)
    setAt       DateTime @default(now()) @map("set_at")

    @@map("monthly_rate_settings")
}

// ----------------------------------------------------------------------------
// 9. Monthly Profit Ledger
// ----------------------------------------------------------------------------
//Not clear
model MonthlyProfitLedger {
    id           String       @id @default(uuid()) @db.Uuid
    periodMonth  DateTime     @map("period_month") @db.Date
    rateApplied  Decimal      @map("rate_applied") @db.Decimal(5, 2)
    profitAmount Decimal      @map("profit_amount") @db.Decimal(14, 2)
    payoutStatus PayoutStatus @default(accrued) @map("payout_status")

    investmentId String     @map("investment_id") @db.Uuid
    investment   Investment @relation(fields: [investmentId], references: [id])

    disbursementItemId String?           @map("disbursement_item_id") @db.Uuid
    disbursementItem   DisbursementItem? @relation(fields: [disbursementItemId], references: [id])

    @@unique([investmentId, periodMonth])
    @@index([periodMonth])
    @@index([payoutStatus])
    @@map("monthly_profit_ledger")
}

// ----------------------------------------------------------------------------
// 10. Disbursement Batches
// ----------------------------------------------------------------------------
//Not clear
model DisbursementBatch {
    id         String                  @id @default(uuid()) @db.Uuid
    slot       DisbursementSlot        @map("slot")
    slotLabel  String                  @map("slot_label") @db.VarChar(50)
    batchDate  DateTime                @map("batch_date") @db.Date
    exportType DisbursementExportType  @map("export_type")
    fileUrl    String?                 @map("file_url")
    status     DisbursementBatchStatus @default(draft)

    // Was: BOTH createdById (User) and adminProfileId (AdminProfile) —
    // two competing answers to "who created this batch". Kept only the
    // AdminProfile reference, consistent with every other admin-action FK.
    // adminProfileId String?  @map("admin_profile_id") @db.Uuid
    createdAt DateTime @default(now()) @map("created_at")

    // adminProfile AdminProfile?      @relation(fields: [adminProfileId], references: [id])
    items DisbursementItem[]

    @@index([slot, batchDate])
    @@index([status])
    @@map("disbursement_batches")
}

// ----------------------------------------------------------------------------
// 11. Disbursement Items
// ----------------------------------------------------------------------------

model DisbursementItem {
    id           String       @id @default(uuid()) @db.Uuid
    reason       String       @db.VarChar(150)
    amount       Decimal      @db.Decimal(14, 2)
    exportFormat ExportFormat @map("export_format")
    remarks      String?      @db.VarChar(255) //Not clear

    investmentId String     @map("investment_id") @db.Uuid
    investment   Investment @relation(fields: [investmentId], references: [id])

    investorId String   @map("investor_id") @db.Uuid
    investor   Investor @relation(fields: [investorId], references: [id])

    batchId String            @map("batch_id") @db.Uuid
    batch   DisbursementBatch @relation(fields: [batchId], references: [id])

    snapshotBankName      String
    snapshotAccountName   String
    snapshotAccountNumber String
    snapshotRoutingNumber String?
    snapshotAccountType   String?

    monthlyProfitLedger MonthlyProfitLedger[]
    withdrawalRequest   WithdrawalRequest?
    referralsPaid       Referral?

    @@map("disbursement_items")
}

// ----------------------------------------------------------------------------
// 12. Withdrawal Requests
// ----------------------------------------------------------------------------

model WithdrawalRequest {
    id               String           @id @default(uuid()) @db.Uuid
    requestedAmount  Decimal          @map("requested_amount") @db.Decimal(14, 2)
    withdrawalMethod WithdrawalMethod @default(auto) @map("withdrawal_method")

    requestDate DateTime @map("request_date") @db.Date

    noticePeriodDays Int?      @map("notice_period_days")
    noticePeriodEnd  DateTime? @map("notice_period_end") @db.Date

    disbursementDate DateTime? @map("disbursement_date") @db.Date

    status WithdrawalStatus @default(pending)

    investmentId String     @map("investment_id") @db.Uuid
    investment   Investment @relation(fields: [investmentId], references: [id])

    paidDisbursementItemId String?           @unique @map("paid_disbursement_item_id") @db.Uuid
    paidDisbursementItem   DisbursementItem? @relation(fields: [paidDisbursementItemId], references: [id])

    @@index([investmentId])
    @@index([status])
    @@map("withdrawal_requests")
}

// ----------------------------------------------------------------------------
// 13. Incoming Payments
// ----------------------------------------------------------------------------

model IncomingPayment {
    id                String                @id @default(uuid()) @db.Uuid
    amount            Decimal               @db.Decimal(14, 2)
    paymentMethod     IncomingPaymentMethod @map("payment_method")
    screenshotUrl     String                @map("screenshot_url")
    senderAccountInfo String?               @map("sender_account_info") @db.VarChar(150)
    installmentNumber Int?                  @map("installment_number")
    dueDate           DateTime?             @map("due_date") @db.Date
    // confirmedById     String?               @map("confirmed_by_id") @db.Uuid
    confirmedAt       DateTime?             @map("confirmed_at")
    status            IncomingPaymentStatus @default(pending)

    investmentId String     @map("investment_id") @db.Uuid
    investment   Investment @relation(fields: [investmentId], references: [id])

    @@index([investmentId])
    @@index([status])
    @@map("incoming_payments")
}

model ReferralCode {
    id     String  @id @default(uuid()) @db.Uuid
    code   String  @unique @db.VarChar(20)
    isUsed Boolean @default(false) @map("is_used")

    // Investor who owns/created this referral code
    referrerId String   @map("referrer_id") @db.Uuid
    referrer   Investor @relation("InvestorReferralCodes", fields: [referrerId], references: [id])

    // Investor who used this referral code
    // null means the code has not been used yet
    referredId String?   @unique @map("referred_id") @db.Uuid
    referred   Investor? @relation("ReferralCodeUsedBy", fields: [referredId], references: [id])

    // Referral code timestamps
    createdAt DateTime  @default(now()) @map("created_at")
    expiresAt DateTime? @map("expires_at")
    usedAt    DateTime? @map("used_at")

    // Referrals created using this referral code
    referrals Referral[]

    // Find referral codes by referrer
    @@index([referrerId])
    // Find unused/used codes belonging to a referrer
    @@index([referrerId, isUsed])
    // Find expired/expiring referral codes
    @@index([expiresAt])
    @@map("referral_codes")
}

// ----------------------------------------------------------------------------
// Referrals
// ----------------------------------------------------------------------------

model Referral {
    id String @id @default(uuid()) @db.Uuid

    // Investor who referred another investor
    referrerId String   @map("referrer_id") @db.Uuid
    referrer   Investor @relation("ReferrerInvestor", fields: [referrerId], references: [id])

    // Investor who was referred
    // @unique means an investor can only be referred once in the entire system
    referredInvestorId String   @unique @map("referred_investor_id") @db.Uuid
    referredInvestor   Investor @relation("ReferredInvestor", fields: [referredInvestorId], references: [id])

    // Referral code used for this referral
    referralCodeId String       @map("referral_code_id") @db.Uuid
    referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id])

    // Referral bonus
    bonusPercent Decimal     @default(1.00) @map("bonus_percent") @db.Decimal(5, 2)
    bonusAmount  Decimal?    @map("bonus_amount") @db.Decimal(14, 2)
    bonusStatus  BonusStatus @default(pending) @map("bonus_status")

    // Disbursement record for the referral bonus
    disbursementItemId String?           @unique @map("disbursement_item_id") @db.Uuid
    disbursementItem   DisbursementItem? @relation(fields: [disbursementItemId], references: [id])

    // Creation timestamp
    createdAt DateTime @default(now()) @map("created_at")

    // Prevent duplicate referrer + referred investor combinations
    @@unique([referrerId, referredInvestorId])
    // Find referrals made by a specific investor
    @@index([referrerId])
    // Find referrals by bonus status
    @@index([bonusStatus])
    @@map("referrals")
}

// ----------------------------------------------------------------------------
// 16. ROI Calculator Leads
// ----------------------------------------------------------------------------

model RoiCalculatorLead {
    id                   String   @id @default(uuid()) @db.Uuid
    name                 String   @db.VarChar(150)
    phoneNumber          String   @map("phone_number") @db.VarChar(20)
    email                String?  @db.VarChar(150)
    enteredAmount        Decimal  @map("entered_amount") @db.Decimal(14, 2)
    calculatedProjection Json?    @map("calculated_projection")
    createdAt            DateTime @default(now()) @map("created_at")
    followedUp           Boolean  @default(false) @map("followed_up")

    @@index([followedUp])
    @@map("roi_calculator_leads")
}

// ----------------------------------------------------------------------------
// 17. Investment Documents
// ----------------------------------------------------------------------------

// ----------------------------------------------------------------------------
// 19. Admin Notifications
// ----------------------------------------------------------------------------

model AdminNotification {
    id            String                @id @default(uuid()) @db.Uuid
    type          AdminNotificationType
    referenceId   String?               @map("reference_id") @db.Uuid
    // Added: referenceId alone doesn't say what table/entity it points to.
    // AuditLog already solves this with targetTable — mirroring that here.
    referenceType String?               @map("reference_type") @db.VarChar(50)

    //have added new field after watching whole payment system.
    message   String   @db.VarChar(255)
    isRead    Boolean  @default(false) @map("is_read")
    createdAt DateTime @default(now()) @map("created_at")

    @@index([isRead, createdAt])
    @@index([type])
    @@map("admin_notifications")
}

// ----------------------------------------------------------------------------
// 20. Audit Log
// ----------------------------------------------------------------------------

model AuditLog {
    id             String   @id @default(uuid()) @db.Uuid
    action         String   @db.VarChar(100)
    targetTable    String   @map("target_table") @db.VarChar(50)
    targetId       String   @map("target_id") @db.Uuid
    details        Json?
    createdAt      DateTime @default(now()) @map("created_at")
    adminProfileId String?  @db.Uuid
    adminName      String?

    @@index([targetTable, targetId])
    @@index([createdAt])
    @@map("audit_log")
}
