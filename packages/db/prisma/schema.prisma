enum AuditAction {
    project_created
    project_updated // any edit to an existing project (fields and/or status)
    project_deleted
    investor_registered
    investor_kyc_uploaded
    investor_kyc_status_changed // e.g. Kamal changed KYC doc status to verified
    investor_status_changed // e.g. investor approved/suspended
    investor_verified // shortcut for status -> active, if you want it separate from the generic one above
    investor_information_updated
    incoming_payment_updated // any admin edit to an incoming-payment record (fields only; status flows via confirm)
    investment_created
    investment_status_changed
    monthly_rate_set
    monthly_rate_updated // any admin edit to an existing monthly rate setting (rate, active flag, period)
    business_settings_set // business settings (rate, cycle day, counting start) created
    business_settings_updated // any edit to an existing business settings row
    disbursement_batch_created
    disbursement_batch_updated // admin edit to an existing disbursement batch
    disbursement_batch_exported
    disbursement_batch_confirmed
    disbursement_batch_deleted // draft-only destructive delete
    disbursement_item_remark_updated // admin edited (or cleared) a disbursement item's remarks
    payout_window_created // admin opened a payout window for a period month
    payout_window_updated // admin edited a payout window
    withdrawal_status_changed
    referral_code_generated
    company_document_uploaded
    // Auth / staff accounts (apps/api/src/auth, admin/admin-account)
    admin_login
    admin_login_failed
    admin_password_reset
    admin_invite_accepted
    admin_created
    admin_invite_resent
