// ----------------------------------------------------------------------------
// 1. Investor profile (1:1 with User where role = INVESTOR)
// ----------------------------------------------------------------------------

model Investor {
    id                         String           @id @default(uuid()) @db.Uuid
    fullname                   String           @map("name") @db.VarChar(150)
    totalInvestmentAmount      Decimal          @default(0) @map("total_investment_amount") @db.Decimal(18, 2)
    totalActiveInvestmentAmout Decimal          @default(0) @db.Decimal(18, 2)
    address                    String?
    // NID number as text (the KYC record only holds card images). Printed on
    // the investment contract. Nullable for investors registered before it existed.
    nidNumber                  String?          @map("nid_number") @db.VarChar(20)
    profession                 String?          @db.VarChar(150)
    workplace                  String?          @db.VarChar(150)
    // Every investor always has a category and status; defaults cover the unset case.
    category                   InvestorCategory @default(bronze)
    status                     InvestorStatus   @default(pending)
    approvedAt                 DateTime?        @map("approved_at") // At the firstDay of activation of this investor
    approvedBy                 String?          @db.Uuid // UserId from User Model who is admin. Dont need adminprofileId
    createdAt                  DateTime         @default(now()) @map("created_at")
    updatedAt                  DateTime         @updatedAt @map("updated_at")

    userId String @unique @map("user_id") @db.Uuid
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    kycDocuments InvestorKycDocument?
    nominee      Nominee?
    guarantor    InvestorGuarantor?
    bankAccount  InvestorBankAccount[]
    investments  Investment[]

    // For Editing field
    investorEditRequest InvestorEditRequest[]

    disbursementItems DisbursementItem[]

    // Referral relations.
    // The referral code this investor used when joining (null when not referred).
    referralCode ReferralCode? @relation("ReferralCodeUsedBy")

    // All referral codes generated and owned by this investor.
    referralCodesGenerated ReferralCode[] @relation("InvestorReferralCodes")

    // The referral record where this investor is the referred investor (at most one).
    referralsReceived Referral? @relation("ReferredInvestor")

    // All referral records where this investor is the referrer.
    referralsMade Referral[] @relation("ReferrerInvestor")

    @@index([status])
    @@map("investors")
}

model InvestorEditRequest {
    id     String            @id @default(uuid()) @db.Uuid
    status EditRequestStatus @default(PENDING)

    reviewedBy      String?   @db.Uuid
    reviewedAt      DateTime?
    rejectionReason String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    editableInvestor    EditableInvestor?
    editableKycDocument EditableInvestorKycDocuments?
    editableNominee     EditableNominee?
    editableUser        EditableUser?

    investorId String   @db.Uuid
    investor   Investor @relation(fields: [investorId], references: [id])

    @@index([investorId, status, createdAt])
}

// ----------------------------------------------------------------------------
// 2. Admin profile (1:1 with User where role in ADMIN/MODERATOR/SUPER_ADMIN)
// ----------------------------------------------------------------------------

model AdminProfile {
    id             String  @id @default(uuid()) @db.Uuid
    name           String? @db.VarChar(150)
    allowedIpRange String? @map("allowed_ip_range") @db.VarChar(100)
    department     String? @db.VarChar(100)

    userId String @unique @map("user_id") @db.Uuid
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    auditLogEntries AuditLog[] // NEW

    @@map("admin_profiles")
}

// ----------------------------------------------------------------------------
// 3. Investor KYC Documents
// ----------------------------------------------------------------------------

model InvestorKycDocument {
    id                 String             @id @default(uuid()) @db.Uuid
    nidFront           String
    nidBack            String
    photo              String
    verificationStatus VerificationStatus @default(pending) @map("verification_status")
    uploadedAt         DateTime           @default(now()) @map("uploaded_at")

    investorId String   @unique @db.Uuid
    investor   Investor @relation(fields: [investorId], references: [id])

    @@index([verificationStatus])
    @@map("investor_kyc_documents")
}

// ----------------------------------------------------------------------------
// 4. Investor Bank Accounts
// ----------------------------------------------------------------------------

model InvestorBankAccount {
    id            String           @id @default(uuid()) @db.Uuid
    selectedBank  BankSelected     @map("selected_bank")
    bankName      String           @map("bank_name") @db.VarChar(100)
    accountName   String           @map("account_name") @db.VarChar(150)
    accountNumber String           @map("account_number") @db.VarChar(50)
    routingNumber String?          @map("routing_number") @db.VarChar(9)
    accountType   BankAccountType? @map("account_type")
    branchName    String?
    isActive      Boolean          @default(false)

    investorId String   @map("investor_id") @db.Uuid
    investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

    @@map("investor_bank_accounts")
}

// ----------------------------------------------------------------------------
// 5. Nominees
// ----------------------------------------------------------------------------

model Nominee {
    id               String  @id @default(uuid()) @db.Uuid
    nomineeName      String  @map("nominee_name") @db.VarChar(150)
    nomineeNidFront  String? @db.VarChar(500)
    nomineeNidBack   String? @db.VarChar(500)
    nomineePhoto     String? @map("nominee_photo")
    nomineePhone     String  @map("nominee_phone") @db.VarChar(20)
    relation         String  @db.VarChar(50)
    // Printed on the investment contract; nullable for nominees added before it existed.
    nomineeNidNumber String? @map("nominee_nid_number") @db.VarChar(20)

    investorId String   @unique @map("investor_id") @db.Uuid
    investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

    @@map("nominees")
}

// ----------------------------------------------------------------------------
// 5b. Investor Guarantors (investor side of the investment contract)
// Optional — an investor has at most one. The company side's guarantor lives
// on ContractSignatory.
// ----------------------------------------------------------------------------

model InvestorGuarantor {
    id       String  @id @default(uuid()) @db.Uuid
    name     String  @db.VarChar(150)
    nid      String  @db.VarChar(20) // NID number as printed on the card (10, 13 or 17 digits)
    phone    String  @db.VarChar(20)
    relation String  @db.VarChar(50) // Relationship to the investor (সম্পর্ক)
    address  String?

    investorId String   @unique @map("investor_id") @db.Uuid
    investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

    @@map("investor_guarantors")
}

// ----------------------------------------------------------------------------
// 5c. Contract Signatories (company side of the investment contract)
// বিনিয়োগ গ্রহণকারী (the person receiving the investment for the company) and
// their guarantor, who carries all liability in the receiver's absence
// (contract clause ১০). Admin-managed. Exactly one row should be active; the
// service flips the others off in the same transaction. Rows used by an
// investment can't be deleted (Restrict), only deactivated.
// ----------------------------------------------------------------------------

model ContractSignatory {
    id String @id @default(uuid()) @db.Uuid

    receiverName      String  @map("receiver_name") @db.VarChar(150)
    receiverNid       String  @map("receiver_nid") @db.VarChar(20)
    receiverPhone     String  @map("receiver_phone") @db.VarChar(20)
    // Storage key of the scanned signature image (PNG with transparent background)
    receiverSignature String? @map("receiver_signature")

    guarantorName      String  @map("guarantor_name") @db.VarChar(150)
    guarantorNid       String  @map("guarantor_nid") @db.VarChar(20)
    guarantorPhone     String  @map("guarantor_phone") @db.VarChar(20)
    guarantorRelation  String  @map("guarantor_relation") @db.VarChar(50) // Relationship to the receiver
    guarantorSignature String? @map("guarantor_signature")

    isActive  Boolean  @default(false) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    investments Investment[]

    @@index([isActive])
    @@map("contract_signatories")
}

// ----------------------------------------------------------------------------
// 6. Projects
// ----------------------------------------------------------------------------

model Project {
    id          String  @id @default(uuid()) @db.Uuid
    name        String  @db.VarChar(150)
    description String?

    status ProjectStatus @default(DRAFT)

    minimumInvestment Decimal  @default(10000) @db.Decimal(18, 2)
    maximumInvestment Decimal? @db.Decimal(18, 2)

    targetAmount               Decimal? @db.Decimal(18, 2)
    totalInvestedAmount        Decimal  @default(0) @db.Decimal(18, 2)
    totalActiveInvestmentAmout Decimal  @default(0) @db.Decimal(18, 2)

    startDate DateTime
    endDate   DateTime?

    isActive  Boolean @default(true)
    isVisible Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    investments Investment[]

    @@index([isVisible, isActive, status, createdAt])
    @@index([minimumInvestment])
    @@index([createdAt, id])
    @@map("projects")
}

// ----------------------------------------------------------------------------
// 7. Company Documents
// ----------------------------------------------------------------------------

model CompanyDocument {
    id         String         @id @default(uuid()) @db.Uuid
    docType    CompanyDocType @map("doc_type")
    fileUrl    String         @map("file_url")
    isCurrent  Boolean        @default(true) @map("is_current")
    uploadedAt DateTime       @default(now()) @map("uploaded_at")
    expiresAt  DateTime?      @map("expires_at") @db.Date

    @@index([docType, isCurrent])
    @@map("company_documents")
}

// ----------------------------------------------------------------------------
// 8. Investments
// ----------------------------------------------------------------------------

model Investment {
    id                     String         @id @default(uuid()) @db.Uuid
    investmentDate         DateTime?      @map("investment_date") @db.Date
    amount                 Decimal        @db.Decimal(14, 2)
    investmentType         InvestmentType @map("investment_type")
    rate                   Decimal?       @db.Decimal(5, 2)
    investmentPeriodMonths Int?           @default(3) @map("investment_period_months")

    disbursementPeriod      DisbursementPeriod @map("disbursement_period")
    agreementPlace          String?            @map("agreement_place") @db.VarChar(150)
    agreementEndDate        DateTime?          @map("agreement_end_date") @db.Date
    deedOffical             String?
    deedGoverment           String?
    chequeGiven             Boolean            @default(false) @map("cheque_given")
    cashVoucharGiven        Boolean            @default(false) @map("cash_vouchar_given")
    specialInstruction      String?            @map("special_instruction")
    souvenirGiven           Boolean            @default(false) @map("souvenir_given")
    isSouvenirApplicable    Boolean            @default(true) @map("is_souvenir_applicable")
    certificateGiven        Boolean            @default(false) @map("certificate_given")
    isCertificateApplicable Boolean            @default(true) @map("is_certificate_applicable")
    status                  InvestmentStatus   @default(pending)

    remarks String? @db.VarChar(255)

    // Investment contract (বিনিয়োগ চুক্তি) PDF. Generated once and stored
    // encrypted; never re-rendered, so it stays the signed snapshot even if
    // profile or signatory data changes later.
    contractFileKey     String?            @map("contract_file_key")
    contractGeneratedAt DateTime?          @map("contract_generated_at")
    contractSignatoryId String?            @map("contract_signatory_id") @db.Uuid
    contractSignatory   ContractSignatory? @relation(fields: [contractSignatoryId], references: [id], onDelete: Restrict)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt

    investorId String   @map("investor_id") @db.Uuid
    investor   Investor @relation(fields: [investorId], references: [id])

    projectId String  @map("project_id") @db.Uuid
    project   Project @relation(fields: [projectId], references: [id])

    monthlyProfitLedger MonthlyProfitLedger[]
    incomingPayments    IncomingPayment?
    withdrawalRequests  WithdrawalRequest[]
    investmentDocuments InvestmentDocument?

    // An investment's slot is determined automatically... Admin can manually move an investment to a different slot if needed
    disbursementItems  DisbursementItem[]
    // disbursementSlot   DisbursementSlot?  @map("disbursement_slot") // investmentDate + 10 din calculate kore
    slotManuallyMoved  Boolean            @default(false) @map("slot_manually_moved")
    slotAdjustmentDays Int?               @map("slot_adjustment_days") // koto din berlo/komlo, audit-er jonno

    @@index([investorId])
    @@index([projectId])
    @@index([status])
    @@map("investments")
}

// ----------------------------------------------------------------------------
// 9. Investment Documents
// ----------------------------------------------------------------------------

model InvestmentDocument {
    id String @id @default(uuid()) @db.Uuid

    online_deed     String?
    certificate     String?
    cheque          String?
    cash_voucher    String?
    membership_card String?
    souvenir        String?
    proof_photo     String?
    clearance_video String? //8

    uploadedAt DateTime @default(now()) @map("uploaded_at")

    investmentId String     @unique @map("investment_id") @db.Uuid
    investment   Investment @relation(fields: [investmentId], references: [id])

    @@index([investmentId])
    @@map("investment_documents")
}

// ----------------------------------------------------------------------------
// 10. Monthly Rate Settings
// ----------------------------------------------------------------------------

model MonthlyRateSetting {
    id          String   @id @default(uuid()) @db.Uuid
    periodMonth DateTime @unique @map("period_month") @db.Date
    ratePercent Decimal  @map("rate_percent") @db.Decimal(3, 2)
    isActive    Boolean  @default(true)
    setAt       DateTime @default(now()) @map("set_at")

    @@map("monthly_rate_settings")
}

// ----------------------------------------------------------------------------
// 11. Monthly Profit Ledger
// ----------------------------------------------------------------------------
model MonthlyProfitLedger {
    id String @id @default(uuid()) @db.Uuid

    cycleStart  DateTime @map("cycle_start") @db.Date
    cycleEnd    DateTime @map("cycle_end") @db.Date
    daysCounted Int      @map("days_counted")

    rateApplied  Decimal      @map("rate_applied") @db.Decimal(3, 2)
    profitAmount Decimal      @map("profit_amount") @db.Decimal(14, 2)
    payoutStatus PayoutStatus @default(accrued) @map("payout_status")

    // Amount still invested this cycle (drops after a partial withdrawal).
    principalAmount Decimal @map("principal_amount") @db.Decimal(14, 2)

    investmentId String     @map("investment_id") @db.Uuid
    investment   Investment @relation(fields: [investmentId], references: [id])

    disbursementItemId String?           @map("disbursement_item_id") @db.Uuid
    disbursementItem   DisbursementItem? @relation(fields: [disbursementItemId], references: [id])

    createdAt DateTime @default(now()) @map("created_at")

    // One row per investment per cycle; stops a double-run job from creating duplicates.
    @@unique([investmentId, cycleStart])
    @@index([cycleEnd])
    @@index([payoutStatus])
    @@map("monthly_profit_ledger")
}

// ----------------------------------------------------------------------------
// 12. Disbursement Batches
// ----------------------------------------------------------------------------

model DisbursementBatch {
    id         String                  @id @default(uuid()) @db.Uuid
    // slot       DisbursementSlot        @map("slot")
    slotLabel  String                  @map("slot_label") @db.VarChar(50)
    batchDate  DateTime                @map("batch_date") @db.Date
    exportType DisbursementExportType  @map("export_type")
    fileUrl    String?                 @map("file_url")
    status     DisbursementBatchStatus @default(draft)
    createdAt  DateTime                @default(now()) @map("created_at")

    windowId String       @map("window_id") @db.Uuid
    window   PayoutWindow @relation(fields: [windowId], references: [id])

    items DisbursementItem[]

    @@index([status])
    @@map("disbursement_batches")
}

// ----------------------------------------------------------------------------
// 13. Payout Window
// ----------------------------------------------------------------------------

model PayoutWindow {
    id          String             @id @default(uuid()) @db.Uuid
    periodMonth DateTime           @map("period_month") @db.Date 
    monthLabel  Month           
    yearLabel   Int
    startDate   DateTime           @map("start_date") @db.Date
    endDate     DateTime           @map("end_date") @db.Date
    status      PayoutWindowStatus @default(open)
    completedAt DateTime?          @map("completed_at")
    createdAt   DateTime           @default(now()) @map("created_at")
    updatedAt   DateTime           @updatedAt @map("updated_at")

    batches DisbursementBatch[]

    // "Overdue" is not stored: status = open and endDate < today.
    @@index([status, endDate])
    @@map("payout_windows")
}

// ----------------------------------------------------------------------------
// 14. Disbursement Items
// ----------------------------------------------------------------------------

model DisbursementItem {
    id           String       @id @default(uuid()) @db.Uuid
    reason       String       @db.VarChar(150)
    amount       Decimal      @db.Decimal(14, 2)
    exportFormat ExportFormat @map("export_format")
    remarks      String?       @db.VarChar(255)
    isDisbursed  Boolean      @default(false)

    investmentId String     @map("investment_id") @db.Uuid
    investment   Investment @relation(fields: [investmentId], references: [id])

    investorId String   @map("investor_id") @db.Uuid
    investor   Investor @relation(fields: [investorId], references: [id])

    batchId String?            @map("batch_id") @db.Uuid
    batch   DisbursementBatch? @relation(fields: [batchId], references: [id])

    type         DisbursementItemType @default(roi)
    investorNote String?              @map("investor_note") @db.VarChar(500) // shown to the investor; `remarks` is internal

    snapshotBankName      String
    snapshotAccountName   String
    snapshotAccountNumber String
    snapshotRoutingNumber String?
    snapshotAccountType   String?
    snapshotBranchName    String?

    monthlyProfitLedger MonthlyProfitLedger[]
    withdrawalRequest   WithdrawalRequest?

    createdAt DateTime @default(now()) @map("created_at")

    @@map("disbursement_items")
}

// ----------------------------------------------------------------------------
// 15. Withdrawal Requests
// ----------------------------------------------------------------------------

model WithdrawalRequest {
    id               String           @id @default(uuid()) @db.Uuid
    requestedAmount  Decimal          @map("requested_amount") @db.Decimal(14, 2)
    withdrawalMethod WithdrawalMethod @default(auto) @map("withdrawal_method")

    requestDate DateTime @map("request_date") @db.Date

    // Set by the server, never by the investor. ROI on the withdrawn part stops on noticePeriodEnd.
    noticePeriodDays Int      @map("notice_period_days")
    noticePeriodEnd  DateTime @map("notice_period_end") @db.Date

    disbursementDate DateTime? @map("disbursement_date") @db.Date

    overrideReason String?   @map("override_reason") @db.VarChar(500) // why the admin changed the notice; shown to the investor
    reviewedBy     String?   @map("reviewed_by") @db.Uuid
    reviewedAt     DateTime? @map("reviewed_at")
    cancelReason   String?   @map("cancel_reason") @db.VarChar(500) // shown to the investor

    // Last ROI on the withdrawn part (cycle start → day before notice end), paid with the next regular ROI.
    finalRoiDays   Int?     @map("final_roi_days")
    finalRoiAmount Decimal? @map("final_roi_amount") @db.Decimal(14, 2)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    status WithdrawalStatus @default(pending)

    investmentId String     @map("investment_id") @db.Uuid
    investment   Investment @relation(fields: [investmentId], references: [id])

    paidDisbursementItemId String?           @unique @map("paid_disbursement_item_id") @db.Uuid
    paidDisbursementItem   DisbursementItem? @relation(fields: [paidDisbursementItemId], references: [id])

    @@index([investmentId])
    @@index([status])
    @@map("withdrawal_requests")
}

// ----------------------------------------------------------------------------
// 16. Incoming Payments
// ----------------------------------------------------------------------------

model IncomingPayment {
    id                String                @id @default(uuid()) @db.Uuid
    amount            Decimal               @db.Decimal(14, 2)
    paymentMethod     IncomingPaymentMethod @map("payment_method")
    screenshotUrl     String                @map("screenshot_url")
    senderAccountInfo String?               @map("sender_account_info") @db.VarChar(150)
    installmentNumber Int?                  @map("installment_number")
    dueDate           DateTime?             @map("due_date") @db.Date
    confirmedAt       DateTime?             @map("confirmed_at")
    status            IncomingPaymentStatus @default(pending)

    investmentId String     @unique @map("investment_id") @db.Uuid
    investment   Investment @relation(fields: [investmentId], references: [id])

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt

    @@index([investmentId])
    @@index([status])
    @@map("incoming_payments")
}

// ----------------------------------------------------------------------------
// 17. Referral Codes
// ----------------------------------------------------------------------------

model ReferralCode {
    id     String  @id @default(uuid()) @db.Uuid
    code   String  @unique @db.VarChar(20)
    isUsed Boolean @default(false) @map("is_used")

    // Investor who owns and created this referral code.
    referrerId String   @map("referrer_id") @db.Uuid
    referrer   Investor @relation("InvestorReferralCodes", fields: [referrerId], references: [id])

    // Investor who used this referral code (null when unused).
    referredId String?   @unique @map("referred_id") @db.Uuid
    referred   Investor? @relation("ReferralCodeUsedBy", fields: [referredId], references: [id])

    // Referral code timestamps.
    createdAt DateTime  @default(now()) @map("created_at")
    expiresAt DateTime? @map("expires_at")
    usedAt    DateTime? @map("used_at")

    // Referrals created using this referral code.
    referrals Referral[]

    @@index([referrerId])
    @@index([referrerId, isUsed])
    @@index([expiresAt])
    @@map("referral_codes")
}

// ----------------------------------------------------------------------------
// 18. Referrals
// ----------------------------------------------------------------------------

model Referral {
    id String @id @default(uuid()) @db.Uuid

    // Investor who referred another investor.
    referrerId String   @map("referrer_id") @db.Uuid
    referrer   Investor @relation("ReferrerInvestor", fields: [referrerId], references: [id])

    // Investor who was referred (unique: an investor can only be referred once).
    referredInvestorId String   @unique @map("referred_investor_id") @db.Uuid
    referredInvestor   Investor @relation("ReferredInvestor", fields: [referredInvestorId], references: [id])

    // Referral code used for this referral.
    referralCodeId String       @map("referral_code_id") @db.Uuid
    referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id])

    // Referral bonus.
    bonusPercent Decimal? @default(1.00) @map("bonus_percent") @db.Decimal(5, 2)
    bonusAmount  Decimal? @map("bonus_amount") @db.Decimal(14, 2)

    // Creation timestamp.
    createdAt DateTime @default(now()) @map("created_at")

    @@unique([referrerId, referredInvestorId])
    @@index([referrerId])
    @@map("referrals")
}

// ----------------------------------------------------------------------------
// 19. ROI Calculator Leads
// ----------------------------------------------------------------------------

model RoiCalculatorLead {
    id            String   @id @default(uuid()) @db.Uuid
    name          String   @db.VarChar(150)
    phoneNumber   String   @map("phone_number") @db.VarChar(20)
    email         String?  @db.VarChar(150)
    enteredAmount Decimal  @map("entered_amount") @db.Decimal(14, 2)
    createdAt     DateTime @default(now()) @map("created_at")
    followedUp    Boolean  @default(false) @map("followed_up")

    @@index([followedUp])
    @@map("roi_calculator_leads")
}

// ----------------------------------------------------------------------------
// 20. Admin Notifications
// ----------------------------------------------------------------------------

model AdminNotification {
    id          String                @id @default(uuid()) @db.Uuid
    type        AdminNotificationType
    referenceId String?               @map("reference_id") @db.Uuid

    message   String?  @db.VarChar(500)
    isRead    Boolean  @default(false) @map("is_read")
    createdAt DateTime @default(now()) @map("created_at")
    clickLink String?

    @@index([isRead, createdAt])
    @@index([type])
    @@map("admin_notifications")
}

// ----------------------------------------------------------------------------
// 21. Audit Log
// ----------------------------------------------------------------------------

model AuditLog {
    id        Int     @id @default(autoincrement())
    adminName String?

    adminProfileId String?       @db.Uuid
    adminProfile   AdminProfile? @relation(fields: [adminProfileId], references: [id])

    // What happened
    action   AuditAction // "UPDATE_PRODUCT", "DELETE_ORDER"
    module   LogModule? // PRODUCT, ORDER, etc.
    severity LogSeverity @default(INFO)
    status   LogStatus   @default(SUCCESS)

    // What was affected
    targetLabel String? // Human-readable name at time of action
    targetTable String  @map("target_table") @db.VarChar(50)
    targetId    String  @map("target_id") @db.VarChar(50)

    // What changed
    oldValue Json? // Previous state
    newValue Json? // New state
    metadata Json? // Extra context

    // Who, where, when
    ipAddress String?
    userAgent String?
    sessionId String? // Group related actions

    statement String?

    createdAt DateTime @default(now())

    @@index([adminProfileId])
    @@index([module])
    @@index([createdAt])
    @@index([targetId])
}

// ----------------------------------------------------------------------------
// 22. Business Settings
// ----------------------------------------------------------------------------
model BusinessSettings {
    id   Int      @id @default(autoincrement())

    rate Decimal? @db.Decimal(3, 2)
    setcycleday Int?
    countingStartAfterDays Int?

    label    String? @db.VarChar(200)
    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}



