// ============================================================================
// Investment Platform — Prisma Schema (v2)
//
// Covers: investor onboarding & KYC, company compliance documents, projects,
// multi-deposit investments (top-up support), Fixed/Unfixed profit engine
// with rate history, monthly profit ledger, bank-file disbursement
// (CBL/BEFTN), 4-slot disbursement scheduling, withdrawal requests
// (manual/auto), referral codes + referral bonuses, nominees, investment
// deliverables (deed/certificate/cheque/souvenir), admin notifications,
// and audit trail.
//
// Naming note: models use `Investor` internally for brevity; UI/labels will
// display "Project Shareholder" per the confirmed terminology decision.
//
// CHANGELOG (this revision):
// - KycDocType: removed trade_license for investor KYC (company-level
//   trade license still tracked separately via CompanyDocType)
// - Investor: address now optional; fixed default status value bug
// - Nominee: nomineeNid now optional; added nomineePhoto, nomineePhone
// - Investment: receivedBy/authorizedBy relations fixed to match nullable
//   FK columns; added disbursement-slot fields; added investmentDocuments
// - New: ReferralCode model (investor-generated, 7-day expiry, 1 active
//   code per investor)
// - Referral: reworked around ReferralCode; added referredInvestorId,
//   bonusPercent (1%, confirmed), and a payout link to DisbursementItem
// - New: DisbursementSlot enum (4 fixed windows) + slot field on
//   DisbursementBatch and Investment
// - WithdrawalRequest: added withdrawalMethod (manual/auto),
//   noticePeriodDays, disbursementDate
// - New: InvestmentDocument model (online deed, certificate, cheque, cash
//   voucher, membership card, souvenir, proof photo, clearance video link)
// - Confirmed: NO payment receipt is issued (see InvestmentDocument note)
//
// CHANGELOG (v3 — this revision, bug-fix pass):
// - Investor.approvedById: was required with no relation — blocked creating
//   a `pending` investor before approval, and had no FK. Now optional, with
//   a real relation to AdminUser, plus a new approvedAt timestamp.
// - Referral system: removed a buggy required/optional-mismatched FK
//   (Investor.referralCodesId/referral) and a dangling, purposeless
//   implicit many-to-many (ReferralCode.investors / Investor.referralCodes)
//   between Investor and ReferralCode. Replaced with one correctly-named
//   ownership relation (InvestorReferralCodes).
// - ReferralCode: added createdAt + expiresAt — the "7-day expiry" in this
//   changelog had no fields backing it.
// - Referral: re-enabled referralCodeId (which physical code was used —
//   needed since codes expire and get regenerated) and added
//   qualifyingInvestmentId (which investment the 1% bonus was computed
//   from — ambiguous once top-ups mean multiple Investment rows exist).
// - MonthlyProfitLedger: added @@unique([investmentId, periodMonth]) —
//   critical fix. Nothing stopped a retried calculation job from creating a
//   second profit row for the same investment/month and double-crediting
//   profit — the same bug class flagged earlier in the TAHAMS courier
//   webhook audit.
// - DisbursementItem.investorBankAccountId: was optional — a disbursement
//   with no destination account could exist and would break CBL/BEFTN
//   export generation. Now required.
// - Added @@index / @@unique on several high-traffic lookup paths
//   (Investment, InvestorKycDocument, IncomingPayment, WithdrawalRequest,
//   DisbursementItem) — the v2 file had none at all.
// - OPEN, RESOLVED this revision (v6): Investor.adminId used to link each
//   investor's login directly to a separate AdminUser table (marked
//   "// Discuss"). Per team decision, Investor and AdminUser are now fully
//   merged into a single `User` model — see CHANGELOG v6 below.
//
// CHANGELOG (v4 — this revision, confirmed-decisions pass):
// - IncomingPaymentMethod: added nagad, rocket — confirmed all four channels
//   (bKash, Nagad, Rocket, bank account) are accepted, not just bKash/bank.
// - IncomingPayment: added required screenshotUrl. Confirmed there is no
//   transaction ID anywhere in this flow — the investor's payment
//   screenshot is the entire verification input admin confirms against,
//   not optional supporting evidence.
// - InvestorKycDocument: re-added @@unique([investorId, docType]). Confirmed
//   each document type is single-upload/overwrite (last upload replaces
//   the previous one), not multi-version history.
//
// CHANGELOG (v5 — this revision):
// - CompanyDocument: added expiresAt (nullable — only trade license needs
//   it; NID/bank account are static). Confirmed trade license must be
//   renewed annually; without a stored expiry, there was no way to build a
//   renewal reminder, and an expired license could keep showing as current.
// - AdminNotificationType: added company_document_expiring, so the
//   existing notification bar can warn admin ahead of the trade license
//   lapsing, consistent with how upcoming_payout/slot_reminder already work.
//
// CHANGELOG (v6 — this revision, Investor + AdminUser merge):
// - Merged `Investor` and `AdminUser` into a single `User` model, per team
//   decision to run one unified login system instead of two. `role`
//   (already an existing enum with INVESTOR/ADMIN/MODERATOR/SUPER_ADMIN)
//   is the discriminator. Investor-only fields (address, profession,
//   category, status, etc.) and admin-only fields (allowedIpRange) now
//   live side by side on the same table, each null for the role it
//   doesn't apply to.
// - Removed the old adminId/admin 1-to-1 hack entirely — that was never a
//   real design, just a workaround for not having a shared user table yet.
// - Added `phone` — this did NOT exist anywhere on the old Investor model,
//   despite being field #8 ("Contact Number") in the original client
//   requirements list. This was a pre-existing gap, not introduced by the
//   merge; it's added now since it also serves as the investor's login
//   identifier (investors log in by phone, admins by email).
// - Every foreign key across the schema that pointed at `Investor` or
//   `AdminUser` (InvestorKycDocument, InvestorBankAccount, Nominee,
//   Investment, DisbursementItem, ReferralCode, Referral, CompanyDocument,
//   MonthlyRateSetting, DisbursementBatch, IncomingPayment,
//   InvestmentDocument, AuditLog) now points at `User` instead. No
//   relation names or @map column names changed — only the type.
// - Trade-off worth knowing, not a bug: this is a single wide table with
//   role-conditional nullable columns (an investor row has null
//   allowedIpRange; an admin row has null address/category/status/etc).
//   This was a deliberate simplicity choice over splitting into
//   User + InvestorProfile + AdminProfile tables. Revisit if the nullable
//   columns start to feel unwieldy as the feature set grows.
// ============================================================================

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum InvestorCategory {
    bronze
    silver
    gold
    diamond
    platinum
    titanium
}

enum InvestorStatus {
    pending // just registered, hasn't uploaded KYC yet
    uploaded_kyc // KYC docs submitted, awaiting admin review
    active // admin approved — profile is now LOCKED, no further self-service edits (confirmed)
    suspended // admin rejected, or later suspended
}

enum KycDocType {
    nid
    photo
    // trade_license removed (confirmed) — not collected for individual
    // investor KYC. Still tracked separately for the company itself via
    // CompanyDocType.trade_license below.
    other
}

enum VerificationStatus {
    pending
    verified
    rejected
}

enum BankAccountType {
    savings
    current
}

enum BankSelected {
    city_bank
    others
}

enum ProjectStatus {
    DRAFT
    OPEN
    FULL
    PAUSED
    COMPLETED
    CANCELLED
}

enum CompanyDocType {
    trade_license
    nid
    bank_account
    deed
}

enum InvestmentType {
    fixed
    unfixed
}

enum DisbursementPeriod {
    monthly
    quarterly
    half_yearly
    yearly
}

enum DeedType {
    official
    government
    none
}

enum InvestmentStatus {
    active // running, earning profit
    withdrawn // a withdrawal is in progress / partially withdrawn
    completed // confirmed: reached once a withdrawal is fully paid out (or the term ends and principal is returned)
}

enum PayoutStatus {
    accrued
    disbursed
}

enum DisbursementExportType {
    cbl
    beftn
    other
}

enum DisbursementBatchStatus {
    draft
    exported
    confirmed
}

enum ExportFormat {
    cbl
    beftn
}

// Confirmed: CBL and BEFTN are always generated as two separate files, even
// when a single batch/slot contains investors of both bank types.

enum WithdrawalStatus {
    pending
    notice_period
    ready
    paid
    cancelled
}

enum WithdrawalMethod {
    manual // admin-driven, requires notice period (see WithdrawalRequest)
    auto // system-scheduled, follows the normal disbursement slot cycle
}

enum IncomingPaymentMethod {
    bkash
    nagad
    rocket
    bank_transfer
}

enum IncomingPaymentStatus {
    pending
    confirmed
    overdue
}

enum BonusStatus {
    pending
    paid
}

enum Role {
    SUPER_ADMIN
    ADMIN
    MODERATOR
    INVESTOR
}

enum AdminNotificationType {
    upcoming_payout
    slot_reminder
    new_investment_request
    disbursement_sent
    // NEW: pairs with CompanyDocument.expiresAt — lets admin get warned
    // before the trade license lapses, instead of finding out when an
    // investor notices an expired document.
    company_document_expiring
}

enum PayoutSchedule {
    MONTHLY
    QUARTERLY
    YEARLY
}

// Confirmed: disbursement counting starts 10 days after the investment date.
// That date is then bucketed into one of 4 fixed monthly windows. Admin can
// manually move an investment to a different slot; slotAdjustmentDays on
// Investment records how many days that manual move added/removed.
enum DisbursementSlot {
    slot_1 // 1st–8th
    slot_2 // 9th–18th
    slot_3 // 19th–25th
    slot_4 // 26th–end of month
}

// New investment deliverables/documents (separate from KYC and legal deed
// classification). Confirmed: NO payment receipt is issued — "certificate"
// below is the investor certificate, not a receipt.
enum InvestmentDocumentType {
    online_deed // signed deed PDF, uploaded to the portal
    certificate // investor certificate
    cheque // security cheque given as part of the agreement
    cash_voucher
    membership_card // "royalty membership card"
    souvenir // keyring, pad, etc.
    proof_photo // single photo uploaded as proof of physical handover
    clearance_video // cheque/deed clearance video — external drive link, not a direct upload
}

// ----------------------------------------------------------------------------
// 1. Investor
// ----------------------------------------------------------------------------

model User {
    id   String @id @default(uuid()) @db.Uuid
    role Role   @default(INVESTOR)

    // --- Shared auth / identity ---
    // FIX (this revision): unified Investor + AdminUser into one User table
    // per team decision — one login system instead of two. Investors log in
    // by phone, admins by email; passwordHash and role are shared.
    name         String   @map("name") @db.VarChar(150) // was `fullName` (Investor) / `name` (AdminUser)
    // NOTE: `phone` did not previously exist anywhere on Investor despite
    // being in the original 31-field client list ("Contact Number") — this
    // was a pre-existing gap, not something the merge introduced. Added
    // here since it doubles as the investor's login identifier.
    phone        String?  @unique @db.VarChar(20)
    email        String?  @unique @db.VarChar(150) // required for admins; optional for investors, but needed for BEFTN/CBL export
    passwordHash String   @map("password_hash") @db.VarChar(255)
    totalInvestmentAmount Decimal  @default(0) @map("total_investment_amount") @db.Decimal(18, 2) // sum of all investments (principal only, no profit)
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    // --- Admin-only fields (null for investors) ---
    allowedIpRange String? @map("allowed_ip_range") @db.VarChar(100) // for IP-restricted admin access

    // --- Investor-only profile fields (null for admins) ---
    address    String? // now optional (confirmed)
    profession String?           @db.VarChar(150) // optional (confirmed)
    workplace  String?           @db.VarChar(150) // optional (confirmed)
    category   InvestorCategory? @default(bronze)
    status     InvestorStatus?   @default(pending)

    approvedById String?   @map("approved_by") @db.Uuid
    approvedAt   DateTime? @map("approved_at")
    // approvedBy   User?     @relation("InvestorApprovedBy", fields: [approvedById], references: [id])
    // investorsApproved User[] @relation("InvestorApprovedBy") // admin side of the same self-relation

    // --- Investor-only relations ---
    kycDocuments           InvestorKycDocument[]
    bankAccount            InvestorBankAccount? // Enforces a single bank account relation
    nominees               Nominee[]
    investments            Investment[]
    disbursementItems      DisbursementItem[]
    referralCodesGenerated ReferralCode[]        @relation("InvestorReferralCodes")
    referralsMade          Referral[]            @relation("ReferrerInvestor") // referrals earned by this investor's code(s)
    referralsReceived      Referral[]            @relation("ReferredInvestor") // referral record where THIS investor was the new signup

    // --- Admin-only relations (audit trail — who did what) ---
    // kycDocumentsVerified        InvestorKycDocument[] @relation("KycDocVerifiedBy")
    // companyDocumentsUploaded    CompanyDocument[]     @relation("CompanyDocUploadedBy")
    // investmentsReceived         Investment[]          @relation("InvestmentReceivedBy")
    // investmentsAuthorized       Investment[]          @relation("InvestmentAuthorizedBy")
    // monthlyRatesSet             MonthlyRateSetting[]  @relation("RateSetBy")
    // disbursementBatchesCreated  DisbursementBatch[]   @relation("BatchCreatedBy")
    // incomingPaymentsConfirmed   IncomingPayment[]     @relation("PaymentConfirmedBy")
    // investmentDocumentsUploaded InvestmentDocument[]  @relation("InvestmentDocUploadedBy")
    auditLogEntries     AuditLog[]
    companyDocuments    CompanyDocument[]
    investments         Investment[]
    investments         Investment[]
    monthlyRateSettings MonthlyRateSetting[]
    disbursementBatches DisbursementBatch[]
    incomingPayments    IncomingPayment[]
    investmentDocuments InvestmentDocument[]

    @@map("users")
}

// ----------------------------------------------------------------------------
// 2. Investor KYC Documents
// ----------------------------------------------------------------------------

model InvestorKycDocument {
    id                 String             @id @default(uuid()) @db.Uuid
    investorId         String             @map("investor_id") @db.Uuid
    docType            KycDocType         @map("doc_type")
    fileUrl            String             @map("file_url") // encrypted storage on secure server, not a public Drive link
    verificationStatus VerificationStatus @default(pending) @map("verification_status")
    verifiedById       String?            @map("verified_by") @db.Uuid
    uploadedAt         DateTime           @default(now()) @map("uploaded_at")

    investor User @relation(fields: [investorId], references: [id])
    // verifier User? @relation("KycDocVerifiedBy", fields: [verifiedById], references: [id])

    // FIX: confirmed each document type is single-upload/overwrite, not
    // multi-version — a new upload for the same type replaces the previous
    // one rather than accumulating history. Enforce at the DB level so the
    // application logic can't accidentally create duplicates per type.
    @@unique([investorId, docType])
    @@index([investorId])
    @@index([verificationStatus])
    @@map("investor_kyc_documents")
}

// ----------------------------------------------------------------------------
// 3. Investor Bank Accounts
// ----------------------------------------------------------------------------

model InvestorBankAccount {
    id            String           @id @default(uuid()) @db.Uuid
    investorId    String           @unique @map("investor_id") @db.Uuid // @unique enforces max 1 account per investor
    selectedBank  BankSelected?    @map("selected_bank")
    bankName      String           @map("bank_name") @db.VarChar(100)
    accountName   String           @map("account_name") @db.VarChar(150) // must match bank records — used as Receiver Name
    accountNumber String           @map("account_number") @db.VarChar(50) // Beneficiary Bank Account No
    routingNumber String?          @map("routing_number") @db.VarChar(20) // Receiving Bank Routing No — Not required for CBL 
    accountType   BankAccountType? @map("account_type")
    branchName    String?

    investor          User               @relation(fields: [investorId], references: [id])
    disbursementItems DisbursementItem[]

    @@map("investor_bank_accounts")
}

// ----------------------------------------------------------------------------
// 4. Nominees
// ----------------------------------------------------------------------------

model Nominee {
    id           String  @id @default(uuid()) @db.Uuid
    investorId   String  @map("investor_id") @db.Uuid
    nomineeName  String  @map("nominee_name") @db.VarChar(150)
    nomineeNid   String? @map("nominee_nid") @db.VarChar(30) // NID Photo Location url
    nomineePhoto String? @map("nominee_photo") // uploaded photo, file URL
    nomineePhone String? @map("nominee_phone") @db.VarChar(20)
    relation     String  @db.VarChar(50)

    investor User @relation(fields: [investorId], references: [id])

    @@map("nominees")
}

// ----------------------------------------------------------------------------
// 5. Projects
// ----------------------------------------------------------------------------

model Project {
    id          String  @id @default(uuid()) @db.Uuid
    name        String  @db.VarChar(150)
    description String? // shown on public project listing

    // Project lifecycle
    status ProjectStatus @default(DRAFT)

    // Investment configuration
    minimumInvestment Decimal  @db.Decimal(18, 2)
    maximumInvestment Decimal? @db.Decimal(18, 2)

    targetAmount        Decimal? @db.Decimal(18, 2)
    totalInvestedAmount Decimal  @default(0) @db.Decimal(18, 2) // cant be show to customer

    // Return configuration
    // investmentType InvestmentType
    // payoutSchedule PayoutSchedule

    // Project duration
    startDate DateTime
    endDate   DateTime?

    // Visibility
    isActive  Boolean @default(true) // admin can deactive, only previous investor can see
    isVisible Boolean @default(true) // control the visibility to Customer 

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    investments Investment[]

    @@map("projects")
}

// ----------------------------------------------------------------------------
// 6. Company Documents
// ----------------------------------------------------------------------------

model CompanyDocument {
    id         String         @id @default(uuid()) @db.Uuid
    docType    CompanyDocType @map("doc_type")
    fileUrl    String         @map("file_url") // encrypted, secure server
    isCurrent  Boolean        @default(true) @map("is_current") // old versions kept for audit history, not overwritten
    uploadedAt DateTime       @default(now()) @map("uploaded_at")
    // FIX: confirmed trade license must be renewed annually, while NID/bank
    // account are static and don't expire. Nullable since only trade
    // license actually needs a deadline. Without this, there's no way to
    // build a renewal reminder, and an expired license could keep showing
    // as `isCurrent: true` — undermining the whole point of showing it.
    expiresAt  DateTime?      @map("expires_at") @db.Date

    // uploadedById String @map("uploaded_by") @db.Uuid
    // uploadedBy   User   @relation("CompanyDocUploadedBy", fields: [uploadedById], references: [id])

    @@index([docType, isCurrent])
    @@map("company_documents")
}

// ----------------------------------------------------------------------------
// 7. Investments (one row per deposit — enables top-ups)
// ----------------------------------------------------------------------------

model Investment {
    id             String         @id @default(uuid()) @db.Uuid
    investorId     String         @map("investor_id") @db.Uuid
    projectId      String         @map("project_id") @db.Uuid
    investmentDate DateTime?      @map("investment_date") //admin panel theke manually dewa hobe
    amount         Decimal        @db.Decimal(14, 2) // principal — always the base for profit calc (non-compounding)
    investmentType InvestmentType @map("investment_type")
    fixedRate      Decimal?       @map("fixed_rate") @db.Decimal(5, 2) // only set if type = fixed; editable going forward, not retroactive

    // Confirmed: if the customer specifies an investment period, it must be
    // 3+ months (enforce in application/service layer — no DB check
    // constraint here). If left unspecified: withdrawal notice is 40 days
    // for amounts under 2,00,000, and case-by-case calculated
    // notice/disclaimer for 2,00,000+ (see WithdrawalRequest.noticePeriodDays).
    investmentPeriodMonths Int? @default(3) @map("investment_period_months")

    disbursementPeriod      DisbursementPeriod @map("disbursement_period")
    agreementPlace          String?            @map("agreement_place") @db.VarChar(150)
    agreementEndDate        DateTime?          @map("agreement_end_date") @db.Date // "days left" is computed as agreementEndDate - CURRENT_DATE, never stored
    deedType                DeedType           @default(none) @map("deed_type")
    chequeGiven             Boolean            @default(false) @map("cheque_given")
    cashVoucharGiven        Boolean            @default(false)
    specialInstruction      String?            @map("special_instruction")
    souvenirGiven           Boolean            @default(false)
    isSouvenirApplicable    Boolean            @default(true)
    certificateGiven        Boolean            @default(false)
    isCertificateApplicable Boolean            @default(true)
    // referralId              String?            @unique @map("referral_id") @db.Uuid
    receivedById            String?            @map("received_by") @db.Uuid
    authorizedById          String?            @map("authorized_by") @db.Uuid
    status                  InvestmentStatus   @default(active)

    // Disbursement slot scheduling (confirmed): counting starts 10 days after
    // investmentDate, which then lands in one of the 4 DisbursementSlot
    // windows. Admin can manually move it — slotAdjustmentDays records the
    // resulting +/- day shift versus the auto-computed slot, for audit.
    disbursementSlot    DisbursementSlot? @map("disbursement_slot")
    slotManuallyChanged Boolean           @default(false) @map("slot_manually_changed")
    slotAdjustmentDays  Int?              @map("slot_adjustment_days")

    createdAt DateTime @default(now()) @map("created_at")

    investor             User                  @relation(fields: [investorId], references: [id])
    project              Project               @relation(fields: [projectId], references: [id])
    // referral            Referral?             @relation(fields: [referralId], references: [id])
    // fixed: receivedBy/authorizedBy made optional to match nullable *_by columns
    receivedBy           User?                 @relation("InvestmentReceivedBy", fields: [receivedById], references: [id])
    authorizedBy         User?                 @relation("InvestmentAuthorizedBy", fields: [authorizedById], references: [id])
    monthlyProfitLedger  MonthlyProfitLedger[]
    incomingPayments     IncomingPayment[]
    withdrawalRequests   WithdrawalRequest[]
    investmentDocuments  InvestmentDocument[] // deed PDF, certificate, cheque, souvenir, proof photo, clearance video link, etc.
    referralsQualifiedBy Referral[] // referral bonus records computed off this specific investment

    @@index([investorId])
    @@index([projectId])
    @@index([status])
    @@index([disbursementSlot])
    @@map("investments")
}

// ----------------------------------------------------------------------------
// 8. Monthly Rate Settings (Unfixed/Variable rate, platform-wide per month)
// ----------------------------------------------------------------------------

model MonthlyRateSetting {
    id          String   @id @default(uuid()) @db.Uuid
    periodMonth DateTime @unique @map("period_month") @db.Date // stored as first-of-month, e.g. 2026-09-01
    ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2) // e.g. 2.00–2.50
    // setById     String   @map("set_by") @db.Uuid
    // setAt       DateTime @default(now()) @map("set_at")

    // setBy User @relation("RateSetBy", fields: [setById], references: [id])

    // Note: not referenced by a hard FK from monthly_profit_ledger — it's a
    // lookup at calculation time. If per-project variable rates are ever
    // needed, add a projectId column and change uniqueness to
    // (projectId, periodMonth).
    @@map("monthly_rate_settings")
}

// ----------------------------------------------------------------------------
// 9. Monthly Profit Ledger (one row per investment per month, immutable)
// ----------------------------------------------------------------------------

model MonthlyProfitLedger {
    id                 String       @id @default(uuid()) @db.Uuid
    investmentId       String       @map("investment_id") @db.Uuid
    periodMonth        DateTime     @map("period_month") @db.Date
    rateApplied        Decimal      @map("rate_applied") @db.Decimal(5, 2) // copied from fixedRate or monthly_rate_settings at calc time
    profitAmount       Decimal      @map("profit_amount") @db.Decimal(14, 2) // investments.amount × rateApplied
    payoutStatus       PayoutStatus @default(accrued) @map("payout_status") // flips to disbursed once paid in a batch 
    disbursementItemId String?      @map("disbursement_item_id") @db.Uuid

    investment       Investment        @relation(fields: [investmentId], references: [id])
    disbursementItem DisbursementItem? @relation(fields: [disbursementItemId], references: [id])

    // Quarterly/annual payouts sum the relevant rows here for the period
    // rather than averaging, per the confirmed decision.
    //
    // FIX (critical): nothing previously stopped two profit rows being
    // created for the same investment in the same month — a re-run of the
    // monthly calculation job would silently double-credit profit. This is
    // the same class of bug flagged earlier in the TAHAMS courier webhook
    // audit (double-count on retry). Added a hard DB constraint so a retry
    // or race condition fails loudly instead of duplicating money.
    @@unique([investmentId, periodMonth])
    @@index([periodMonth])
    @@index([payoutStatus])
    @@map("monthly_profit_ledger")
}

// ----------------------------------------------------------------------------
// 10. Disbursement Batches (one per admin-run payout batch, per slot)
// ----------------------------------------------------------------------------

model DisbursementBatch {
    id          String                  @id @default(uuid()) @db.Uuid
    slot        DisbursementSlot        @map("slot") // one of the 4 fixed windows (see DisbursementSlot enum)
    slotLabel   String                  @map("slot_label") @db.VarChar(50) // human-readable display label, e.g. "1st–8th"
    batchDate   DateTime                @map("batch_date") @db.Date
    exportType  DisbursementExportType  @map("export_type") // cbl and beftn are always separate files (confirmed), even inside one batch
    fileUrl     String?                 @map("file_url") // generated Excel file, stored for record-keeping
    status      DisbursementBatchStatus @default(draft)
    createdById String                  @map("created_by") @db.Uuid
    createdAt   DateTime                @default(now()) @map("created_at")

    // createdBy User               @relation("BatchCreatedBy", fields: [createdById], references: [id])
    items     DisbursementItem[]

    @@map("disbursement_batches")
}

// ----------------------------------------------------------------------------
// 11. Disbursement Items (line items — maps to CBL/BEFTN export columns)
// ----------------------------------------------------------------------------

model DisbursementItem {
    id           String       @id @default(uuid()) @db.Uuid
    batchId      String       @map("batch_id") @db.Uuid
    investorId   String       @map("investor_id") @db.Uuid
    reason       String       @db.VarChar(150) // e.g. "ROI Disbursement — Sept 2026"
    amount       Decimal      @db.Decimal(14, 2) // sum of relevant monthly_profit_ledger rows
    exportFormat ExportFormat @map("export_format") // determined by investor's bank at export time — cbl/beftn always split into separate files
    remarks      String?      @db.VarChar(255) // optional special comment

    batch               DisbursementBatch     @relation(fields: [batchId], references: [id])
    investor            User                  @relation(fields: [investorId], references: [id])
    monthlyProfitLedger MonthlyProfitLedger[]
    withdrawalRequests  WithdrawalRequest[]
    referralsPaid       Referral[] // referral bonuses settled through this same disbursement item

    // FIX: was optional (String?/InvestorBankAccount?) — a disbursement item
    // with no destination account could exist and would break CBL/BEFTN
    // export generation for that row. Every disbursement must have a target
    // account, so this is now required.
    investorBankAccountId String              @db.Uuid
    investorBankAccount   InvestorBankAccount @relation(fields: [investorBankAccountId], references: [id])

    // Export query joins this table with investors and investor_bank_accounts
    // to produce the exact 11-column CBL/BEFTN file (Reason, Sender Account
    // No, Receiving Bank Routing No, Beneficiary Bank Account No, Account
    // Type, Amount, Receiver ID, Receiver Name, Remarks, Receiver Mobile
    // Number, Receiver Email Address).
    @@unique([batchId, investorId, investorBankAccountId])
    @@index([investorId])
    @@map("disbursement_items")
}

// ----------------------------------------------------------------------------
// 12. Withdrawal Requests (principal withdrawal, manual or auto)
// ----------------------------------------------------------------------------

model WithdrawalRequest {
    id               String           @id @default(uuid()) @db.Uuid
    requestedAmount  Decimal          @map("requested_amount") @db.Decimal(14, 2) // capped at 200,000 per request — confirm per-request vs per-period with client
    withdrawalMethod WithdrawalMethod @default(auto) @map("withdrawal_method")

    requestDate DateTime @map("request_date") @db.Date

    // Confirmed rules (computed in application logic, stored here once
    // decided): manual withdraw = 7 days notice by default. If the
    // investment's period was left unspecified, the notice instead follows
    // the amount-based rule on Investment (40 days if < 2,00,000; calculated
    // case-by-case, given as a notice/disclaimer, if >= 2,00,000).
    noticePeriodDays Int?      @map("notice_period_days")
    noticePeriodEnd  DateTime? @map("notice_period_end") @db.Date // requestDate + noticePeriodDays; null for auto withdrawals // discuss

    disbursementDate DateTime? @map("disbursement_date") @db.Date // actual payout date, assigned by admin

    status WithdrawalStatus @default(pending)

    investmentId String     @map("investment_id") @db.Uuid
    investment   Investment @relation(fields: [investmentId], references: [id])

    paidDisbursementItemId String?           @map("paid_disbursement_item_id") @db.Uuid
    paidDisbursementItem   DisbursementItem? @relation(fields: [paidDisbursementItemId], references: [id])

    @@index([investmentId])
    @@index([status])
    @@map("withdrawal_requests")
}

// ----------------------------------------------------------------------------
// 13. Incoming Payments (investor → company deposits/installments)
// ----------------------------------------------------------------------------
// Confirmed: NO receipt is issued for these payments (see
// InvestmentDocument.certificate, which is a certificate, not a receipt).

model IncomingPayment {
    id                String                @id @default(uuid()) @db.Uuid
    investmentId      String                @map("investment_id") @db.Uuid
    amount            Decimal               @db.Decimal(14, 2)
    paymentMethod     IncomingPaymentMethod @map("payment_method")
    // FIX: confirmed there is no transaction ID in this flow at all —
    // investor uploads a screenshot of the payment and admin manually
    // confirms against it. The screenshot IS the verification input, so
    // it's required, not optional supporting evidence.
    screenshotUrl     String                @map("screenshot_url") // required proof-of-payment upload
    senderAccountInfo String?               @map("sender_account_info") @db.VarChar(150) // bKash/Nagad/Rocket number or bank account
    installmentNumber Int?                  @map("installment_number")
    dueDate           DateTime?             @map("due_date") @db.Date // for installment reminders (5–7 day rule)
    confirmedById     String?               @map("confirmed_by") @db.Uuid
    confirmedAt       DateTime?             @map("confirmed_at")
    status            IncomingPaymentStatus @default(pending)

    investment  Investment @relation(fields: [investmentId], references: [id])
    // confirmedBy User?      @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])

    @@index([investmentId])
    @@index([status])
    @@map("incoming_payments")
}

// ----------------------------------------------------------------------------
// 14. Referral Codes (NEW — generated by an existing investor, 7-day expiry)
// ----------------------------------------------------------------------------

model ReferralCode {
    id        String   @id @default(uuid()) @db.Uuid
    code      String   @unique @db.VarChar(20)
    isActive  Boolean  @default(true) @map("is_active") // confirmed: only one active code per investor at a time — enforce on generation in app logic
    // FIX: changelog says "7-day expiry" but no fields existed to store or
    // compute it. Added createdAt + an explicit expiresAt (set at creation
    // time as createdAt + 7 days) so expiry is queryable directly.
    createdAt DateTime @default(now()) @map("created_at")
    expiresAt DateTime @map("expires_at")

    referrerId String @map("investor_id") @db.Uuid // owner — existing investor who generated this code
    referrer   User   @relation("InvestorReferralCodes", fields: [referrerId], references: [id])
    // FIX: removed the dangling `investors Investor[]` — it formed an
    // unnamed implicit many-to-many with Investor.referralCodes that had no
    // defined business meaning and duplicated the ownership relation above.

    referrals Referral[] // referral records where this specific code was used

    @@map("referral_codes")
}

// ----------------------------------------------------------------------------
// 15. Referrals
// ----------------------------------------------------------------------------

model Referral {
    id String @id @default(uuid()) @db.Uuid

    // FIX: re-enabled — without this, there's no record of WHICH physical
    // code was used (codes expire after 7 days and a referrer may generate
    // several over time), making fraud review / audit impossible.
    referralCodeId String @map("referral_code_id") @db.Uuid
    referrerId     String @db.Uuid // owner of the code (denormalized for quick lookup)
    newInvestorId  String @unique @db.Uuid // the NEW investor who signed up using the code

    // FIX: re-enabled — bonusAmount is computed as this specific
    // investment's amount × bonusPercent. Without this FK there was no way
    // to know (or re-verify) which investment the bonus was based on,
    // especially once top-ups mean an investor has multiple Investment rows.
    qualifyingInvestmentId String @map("qualifying_investment_id") @db.Uuid

    // Confirmed: referral bonus is 1% of the new investor's investment amount.
    bonusPercent Decimal     @default(1.00) @map("bonus_percent") @db.Decimal(5, 2)
    bonusAmount  Decimal?    @map("bonus_amount") @db.Decimal(14, 2) // = qualifying investment's amount × bonusPercent, filled once that investment exists
    bonusStatus  BonusStatus @default(pending) @map("bonus_status")

    paidDisbursementItemId String? @map("paid_disbursement_item_id") @db.Uuid // bonus payout follows the normal disbursement slot pipeline, same as profit

    referralCode         ReferralCode      @relation(fields: [referralCodeId], references: [id])
    referrer             User              @relation("ReferrerInvestor", fields: [referrerId], references: [id])
    newInvestor          User              @relation("ReferredInvestor", fields: [newInvestorId], references: [id])
    qualifyingInvestment Investment        @relation(fields: [qualifyingInvestmentId], references: [id])
    paidDisbursementItem DisbursementItem? @relation(fields: [paidDisbursementItemId], references: [id])

    // Confirmed: one referrer can only be credited once for the same new
    // investor — stops duplicate/retry signups from creating two payable
    // referral bonuses for the same relationship.
    @@unique([referrerId, newInvestorId])
    @@map("referrals")
}

// ----------------------------------------------------------------------------
// 16. ROI Calculator Leads (public calculator usage)
// ----------------------------------------------------------------------------

model RoiCalculatorLead {
    id                   String   @id @default(uuid()) @db.Uuid
    name                 String   @db.VarChar(150)
    phoneNumber          String   @map("phone_number") @db.VarChar(20)
    email                String?  @db.VarChar(150)
    enteredAmount        Decimal  @map("entered_amount") @db.Decimal(14, 2)
    calculatedProjection Json?    @map("calculated_projection") // snapshot of what was shown to them
    createdAt            DateTime @default(now()) @map("created_at")
    followedUp           Boolean  @default(false) @map("followed_up")

    @@map("roi_calculator_leads")
}

// ----------------------------------------------------------------------------
// 17. Investment Documents (NEW — deed, certificate, cheque, souvenir, etc.)
// ----------------------------------------------------------------------------
// Confirmed: NO receipt is issued to investors. "certificate" here is the
// investor certificate, distinct from a payment receipt.

model InvestmentDocument {
    id           String                 @id @default(uuid()) @db.Uuid
    investmentId String                 @map("investment_id") @db.Uuid
    docType      InvestmentDocumentType @map("doc_type")
    fileUrl      String?                @map("file_url") // direct upload — used for online_deed, certificate, proof_photo
    driveLink    String?                @map("drive_link") // external drive link — used for clearance_video

    // For souvenir/membership_card items with a printed serial/code and an
    // approximate value. Example tiers mentioned (50k / 20k-15k = 5k / 15k)
    // still need to be confirmed with the client before hardcoding any
    // amount-based tiering logic.
    serialNumber String?  @map("serial_number") @db.VarChar(50)
    priceTag     Decimal? @map("price_tag") @db.Decimal(10, 2)

    uploadedById String?  @map("uploaded_by") @db.Uuid
    uploadedAt   DateTime @default(now()) @map("uploaded_at")

    investment Investment @relation(fields: [investmentId], references: [id])
    uploadedBy User?      @relation("InvestmentDocUploadedBy", fields: [uploadedById], references: [id])

    @@map("investment_documents")
}

// ----------------------------------------------------------------------------
// 18. (removed — AdminUser merged into User, section 1, per team decision)
// ----------------------------------------------------------------------------

// ----------------------------------------------------------------------------
// 19. Admin Notifications (backs the admin notification bar)
// ----------------------------------------------------------------------------

model AdminNotification {
    id          String                @id @default(uuid()) @db.Uuid
    type        AdminNotificationType
    referenceId String?               @map("reference_id") @db.Uuid // points to investments.id, disbursement_batches.id, or incoming_payments.id depending on type
    message     String                @db.VarChar(255)
    isRead      Boolean               @default(false) @map("is_read")
    createdAt   DateTime              @default(now()) @map("created_at")

    @@map("admin_notifications")
}

// ----------------------------------------------------------------------------
// 20. Audit Log (general-purpose action trail)
// ----------------------------------------------------------------------------

model AuditLog {
    id          String   @id @default(uuid()) @db.Uuid
    action      String   @db.VarChar(100) // e.g. "verified_kyc", "exported_batch", "set_monthly_rate"
    targetTable String   @map("target_table") @db.VarChar(50)
    targetId    String   @map("target_id") @db.Uuid
    details     Json?
    createdAt   DateTime @default(now()) @map("created_at")

    adminId String @map("admin_id") @db.Uuid
    admin   User   @relation(fields: [adminId], references: [id])

    @@map("audit_log")
}
