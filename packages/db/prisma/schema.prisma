model EditableNominee {
    id              String  @id @default(uuid()) @db.Uuid
    nomineeName     String? @map("nominee_name") @db.VarChar(150)
    nomineeNidFront String? @db.VarChar(500)
    nomineeNidBack  String? @db.VarChar(500)
    nomineePhoto    String? @map("nominee_photo")
    nomineePhone    String? @map("nominee_phone") @db.VarChar(20)
