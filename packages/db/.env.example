# Local Postgres from the repo's docker-compose.yml (`docker compose up -d db`,
# host port 5433): both URLs are the same. Use this for development — the
# demo-account seed (pnpm --filter api seed:demo) only runs against localhost.
DATABASE_URL="postgresql://user:password@localhost:5433/investment_platform?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5433/investment_platform?schema=public"

# Supabase (Dashboard → Connect → ORMs → Prisma). Copy the exact host from
# there — the region part (aws-0-<region>) differs per project.
#   DATABASE_URL = Transaction pooler, port 6543, with ?pgbouncer=true
#   DIRECT_URL   = Session pooler, port 5432 (the "Direct connection" host
#                  db.<ref>.supabase.co is IPv6-only on the free plan, which
#                  many home networks and Render can't reach)
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
