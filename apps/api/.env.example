# Validated at boot by src/config/env.ts — the API refuses to start if a
# required value is missing or malformed. DATABASE_URL may live here or in
# packages/db/.env (both are loaded).

# HS256 key for access-token JWTs, 32+ chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Never reuse between environments; rotating it logs everyone out.
JWT_ACCESS_SECRET=

# Exact origin(s) of secure-web, comma-separated. Used for CORS and the
# CSRF Origin check — requests from any other site are rejected.
CORS_ORIGINS=http://localhost:3001

# Email (password reset + admin invites) via Resend. All three are REQUIRED
# when NODE_ENV=production. In dev, leave RESEND_API_KEY empty and the
# email (including its link) is printed to the API console instead.
RESEND_API_KEY=
# Must use a domain you've verified in the Resend dashboard.
MAIL_FROM="Investment Platform <no-reply@yourdomain.com>"
# Public URL of secure-web; links go to $APP_URL/reset-password and
# $APP_URL/set-password (token arrives in the #fragment). Dev default: first CORS origin.
APP_URL=http://localhost:3001

# --- Optional (defaults shown) -------------------------------------------
# NODE_ENV=development          # "production" turns on Secure cookies
# PORT=3000
# ACCESS_TOKEN_TTL_MINUTES=15
# INVESTOR_SESSION_TTL_HOURS=168  # absolute; refresh does not extend it
# ADMIN_SESSION_TTL_HOURS=8
# JWT_ISSUER=investment-platform-api
# JWT_AUDIENCE=investment-platform-secure-web
# COOKIE_DOMAIN=                 # leave unset unless api and web are on different subdomains
# TRUST_PROXY_HOPS=0             # set to 1 behind nginx, or admin IP checks see the proxy's IP

# Only for `pnpm test:e2e` — a DISPOSABLE database (tables are wiped).
# TEST_DATABASE_URL=
